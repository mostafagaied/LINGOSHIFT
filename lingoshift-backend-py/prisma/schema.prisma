generator client {
  provider             = "prisma-client-py"
  recursive_type_depth = 5
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(uuid())
  fullName     String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  projects     Project[]
  documents    Document[]
}

model Project {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id])
  userId    String
  documents Document[]

  @@unique([userId, name])
}

model Document {
  id               String    @id @default(uuid())
  fileName         String
  fileType         String    // "pdf" | "docx" | "txt"
  sourceLanguage   String
  targetLanguage   String
  originalPath     String    // path to the original uploaded file
  translatedPath   String    // path to the generated translated file
  originalText     String?   // extracted original text, for the side-by-side view (FR-05)
  translatedText   String?   // translated text, for the side-by-side view (FR-05)
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id])
  userId           String
  project          Project?  @relation(fields: [projectId], references: [id])
  projectId        String?
}